diff --git a/app/WorkspaceBatch.m b/app/WorkspaceBatch.m
new file mode 100644
index 0000000..3f43f91
--- /dev/null
+++ b/app/WorkspaceBatch.m
@@ -0,0 +1,160 @@
+#if !ISH_LINUX
+#import <UIKit/UIKit.h>
+#import <BackgroundTasks/BackgroundTasks.h>
+#import "SceneDelegate.h"
+#include "fs/dev.h"
+#include "kernel/task.h"
+#include "kernel/errno.h"
+
+// The guest script and the system task belong to the same app. All scheduler
+// state lives on the main queue. Guest threads only wait for the initial grant.
+API_AVAILABLE(ios(26.0))
+@interface WorkspaceBatch : NSObject
+@property(nonatomic) pid_t_ pid;
+@property(nonatomic) uint64_t instance;
+@property(nonatomic) NSInteger steps;
+@property(nonatomic,strong) dispatch_semaphore_t granted;
+@property(nonatomic,strong) UIAlertController *prompt;
+@property(nonatomic,strong) BGContinuedProcessingTask *task;
+@property(atomic) BOOL began;
+@end
+@implementation WorkspaceBatch
+@end
+
+static WorkspaceBatch *active API_AVAILABLE(ios(26.0));
+static BOOL registered;
+static NSString *identifier(void) {
+    return [NSBundle.mainBundle.bundleIdentifier stringByAppendingString:@".workspace.batch"];
+}
+
+// Validate the original session leader under the same lock as signal delivery.
+// A recycled pid must never result in another command receiving a signal.
+static void stopWorkers(pid_t_ pid, uint64_t instance) {
+    lock(&pids_lock);
+    struct task *leader = pid_get_task(pid);
+    if (leader && leader->instance_id == instance && leader->group->sid == pid &&
+            leader->group->pgid == pid) {
+        struct tgroup *group;
+        struct pid *entry = pid_get(pid);
+        list_for_each_entry(&entry->pgroup, group, pgroup)
+            send_signal(group->leader, SIGKILL_, SIGINFO_NIL);
+    }
+    unlock(&pids_lock);
+}
+
+static void finish(WorkspaceBatch *batch, BOOL success, BOOL terminate) API_AVAILABLE(ios(26.0)) {
+    if (active != batch) return;
+    active = nil;
+    if (batch.prompt.presentingViewController) [batch.prompt dismissViewControllerAnimated:YES completion:nil];
+    batch.prompt = nil;
+    if (terminate && batch.began) stopWorkers(batch.pid, batch.instance);
+    if (batch.task) {
+        batch.task.expirationHandler = nil;
+        [batch.task setTaskCompletedWithSuccess:success];
+        batch.task = nil;
+    } else {
+        [BGTaskScheduler.sharedScheduler cancelTaskRequestWithIdentifier:identifier()];
+    }
+    dispatch_semaphore_signal(batch.granted);
+}
+
+void RegisterWorkspaceBackgroundTask(void) {
+    if (@available(iOS 26.0, *)) {
+        registered = [BGTaskScheduler.sharedScheduler registerForTaskWithIdentifier:identifier()
+            usingQueue:dispatch_get_main_queue() launchHandler:^(BGTask *delivered) {
+            WorkspaceBatch *batch = active;
+            if (!batch || batch.task || ![delivered isKindOfClass:BGContinuedProcessingTask.class]) {
+                [delivered setTaskCompletedWithSuccess:NO];
+                return;
+            }
+            batch.task = (BGContinuedProcessingTask *)delivered;
+            batch.task.progress.totalUnitCount = batch.steps;
+            batch.task.progress.completedUnitCount = 0;
+            delivered.expirationHandler = ^{
+                dispatch_async(dispatch_get_main_queue(), ^{ finish(batch, NO, YES); });
+            };
+            batch.began = YES;
+            dispatch_semaphore_signal(batch.granted);
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 660 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+                finish(batch, NO, YES);
+            });
+        }];
+    }
+}
+
+static void askToStart(WorkspaceBatch *batch, NSString *label) API_AVAILABLE(ios(26.0)) {
+    UIViewController *presenter = currentTerminalViewController;
+    if (!registered || active || !presenter.viewIfLoaded.window || presenter.presentedViewController ||
+            presenter.view.window.windowScene.activationState != UISceneActivationStateForegroundActive) {
+        dispatch_semaphore_signal(batch.granted);
+        return;
+    }
+    active = batch;
+    NSString *detail = [NSString stringWithFormat:@"%@ · %ld 個步驟", label, (long)batch.steps];
+    batch.prompt = [UIAlertController alertControllerWithTitle:@"開始 iSH 工作？" message:detail
+                                                preferredStyle:UIAlertControllerStyleAlert];
+    [batch.prompt addAction:[UIAlertAction actionWithTitle:@"取消" style:UIAlertActionStyleCancel
+                                                  handler:^(UIAlertAction *a) { finish(batch, NO, NO); }]];
+    [batch.prompt addAction:[UIAlertAction actionWithTitle:@"開始" style:UIAlertActionStyleDefault
+                                                  handler:^(UIAlertAction *a) {
+        if (active != batch) return;
+        BGContinuedProcessingTaskRequest *request = [[BGContinuedProcessingTaskRequest alloc]
+                initWithIdentifier:identifier() title:@"iSH Workspace" subtitle:detail];
+        request.strategy = BGContinuedProcessingTaskRequestSubmissionStrategyFail;
+        if (![BGTaskScheduler.sharedScheduler submitTaskRequest:request error:nil]) finish(batch, NO, NO);
+    }]];
+    [presenter presentViewController:batch.prompt animated:YES completion:nil];
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 50 * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+        if (active == batch && !batch.began) finish(batch, NO, NO);
+    });
+}
+
+static ssize_t batchWrite(struct fd *fd, const void *buf, size_t length) {
+    if (!length || length > 240 || !current || NSThread.isMainThread) return _EINVAL;
+    if (@available(iOS 26.0, *)) {
+        @autoreleasepool {
+            NSString *line = [[[NSString alloc] initWithBytes:buf length:length encoding:NSUTF8StringEncoding]
+                    stringByTrimmingCharactersInSet:NSCharacterSet.newlineCharacterSet];
+            if (!line.length) return _EINVAL;
+            pid_t_ pid = current->pid;
+            uint64_t instance = current->instance_id;
+            if ([line hasPrefix:@"begin "]) {
+                NSArray *parts = [line componentsSeparatedByString:@" "];
+                if (parts.count < 3) return _EINVAL;
+                NSInteger steps = [parts[1] integerValue];
+                if (steps < 1 || steps > 10) return _EINVAL;
+                lock(&pids_lock);
+                BOOL isolated = current->group->sid == pid && current->group->pgid == pid;
+                unlock(&pids_lock);
+                if (!isolated) return _EPERM;
+                WorkspaceBatch *batch = [WorkspaceBatch new];
+                batch.pid = pid;
+                batch.instance = instance;
+                batch.steps = steps;
+                batch.granted = dispatch_semaphore_create(0);
+                NSString *label = [[parts subarrayWithRange:NSMakeRange(2, parts.count - 2)] componentsJoinedByString:@" "];
+                dispatch_async(dispatch_get_main_queue(), ^{ askToStart(batch, label); });
+                dispatch_semaphore_wait(batch.granted, DISPATCH_TIME_FOREVER);
+                return batch.began ? (ssize_t)length : _EACCES;
+            }
+            __block ssize_t result = _EINVAL;
+            dispatch_sync(dispatch_get_main_queue(), ^{
+                WorkspaceBatch *batch = active;
+                if (!batch || !batch.began || batch.instance != instance) return;
+                if ([line isEqualToString:@"step"] && batch.task.progress.completedUnitCount < batch.steps)
+                    batch.task.progress.completedUnitCount++;
+                else if ([line isEqualToString:@"done"] && batch.task.progress.completedUnitCount == batch.steps)
+                    finish(batch, YES, NO);
+                else if ([line isEqualToString:@"failed"])
+                    finish(batch, NO, NO);
+                else return;
+                result = (ssize_t)length;
+            });
+            return result;
+        }
+    }
+    return _ENOSYS;
+}
+
+struct dev_ops workspace_batch_dev = { .fd.write = batchWrite };
+#endif
